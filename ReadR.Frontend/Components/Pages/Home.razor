@page "/"
@page "/feed/{FeedSlug}"
@rendermode @(new InteractiveServerRenderMode())
@using ReadR.Frontend.Models
@using ReadR.Frontend.ViewModels
@using ReadR.Frontend.Components.Shared
@using ReadR.Frontend.Services

<PageTitle>@viewModel.GetPageTitle() - ReadR</PageTitle>

<div class="app-container">
    <!-- Navigation Bar -->
    <NavBar FeedCount="viewModel.TotalFeedCount" 
            EntryCount="viewModel.TotalEntryCount"
            HomeViewModel="viewModel"
            OnAddFeedClick="ShowAddFeedDialog"
            PageChanged="OnPageChangedAsync" />
    
    <!-- Main Content -->
    <div class="main-content">

        @if (viewModel.IsLoading)
        {
            <LoadingState Title="Fetching latest posts" Subtitle="This won't take long..." />
        }
        else if (viewModel.ErrorMessage != null)
        {
            <ErrorState />
        }
        else if (viewModel.Entries?.Any() == true && CurrentPageEntries.Any())
        {
            <!-- Current Page Summary Section - Only show if AI is available -->
            @if (aiSummaryAvailable)
            {
                <div class="navigation-container">
                    <div class="weekly-summary-section">
                        <div class="summary-header">
                            <h3>📰 Current Page Summary</h3>
                            <button class="btn btn-primary" @onclick="GenerateCurrentPageSummary" disabled="@isGeneratingSummary">
                                @if (isGeneratingSummary)
                                {
                                    <span>🤖 Generating...</span>
                                }
                                else
                                {
                                    <span>Summarize These Articles</span>
                                }
                            </button>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(currentPageSummary))
                        {
                            <div class="summary-content">
                                @((MarkupString)currentPageSummary)
                            </div>
                        }
                        else if (summaryError != null)
                        {
                            <div class="summary-error">
                                <p>⚠️ Error generating summary: @summaryError</p>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="navigation-container">

                <div class="feeds-grid">
                    @foreach (var entry in CurrentPageEntries)
                    {
                        <Card FeedEntry="entry" />
                    }
                </div>

                <FeedNavigationBar HomeViewModel="viewModel" 
                                   PageChanged="OnPageChangedAsync" 
                                   ShowKeyboardHelpRequested="ShowKeyboardHelp" />
            </div>
        }
        else
        {
            <EmptyState Icon="📭"
                        Title="No posts available"
                        Message="You haven't subscribed to any feeds yet or there are no posts to display."
                        ActionIcon="➕"
                        ActionText="Add Feeds"
                        OnRefresh='EventCallback.Factory.Create(this, ShowAddFeedDialog)'/>
        }
    </div>
</div>

<!-- Add Feed Dialog -->
<AddFeedDialog IsVisible="isAddFeedDialogVisible" 
               OnClose="HideAddFeedDialog" 
               OnAddFeed="HandleAddFeedSubmit"
               FeedManagementService="FeedManagementService" />

<!-- Keyboard Help Dialog -->
<KeyboardHelp IsVisible="isKeyboardHelpVisible" 
              OnClose="HideKeyboardHelp" />

<script src="js/home.js"></script>
